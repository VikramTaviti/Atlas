# Optional Google Gemini credentials. Keep actual .env files out of version control.
GEMINI_API_KEY=

# Optional model generation settings.
ATLAS_GEMINI_MODEL=gemini-3.5-flash-lite
ATLAS_GEMINI_TEMPERATURE=0.2
ATLAS_GEMINI_TIMEOUT_SECONDS=45
ATLAS_GEMINI_MAX_OUTPUT_TOKENS=2048

# Optional USD prices per million tokens for telemetry estimates (model/account specific).
# ATLAS_GEMINI_INPUT_PRICE_PER_MILLION_USD=
# ATLAS_GEMINI_OUTPUT_PRICE_PER_MILLION_USD=

# For docker-compose.gemini.yml only; point this at a local file containing the API key.
# ATLAS_GEMINI_KEY_FILE=./secrets/gemini_api_key
